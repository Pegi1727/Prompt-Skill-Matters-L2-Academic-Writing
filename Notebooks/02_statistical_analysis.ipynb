{
 "cells": [
  { "cell_type": "markdown", "metadata": {}, "source": ["# 2. Statistical Analysis\n", "این نوت‌بوک وظیفه‌ی اجرای تست‌های آماری شامل Welch's t-test و رگرسیون کالیبراسیون را بر عهده دارد."] },
  { "cell_type": "code", "execution_count": null, "metadata": {}, "outputs": [], "source": [
    "import pandas as pd\n",
    "import scipy.stats as stats\n",
    "import statsmodels.api as sm\n",
    "\n",
    "# بارگذاری داده‌ها\n",
    "df = pd.read_csv('raw_rater_scoring.csv')\n",
    "\n",
    "# تحلیل رگرسیون\n",
    "X = sm.add_constant(df['Raw_PSI_Mean'])\n",
    "y = df['Avg_PSI_Target']\n",
    "model = sm.OLS(y, X).fit()\n",
    "print(model.summary())\n",
    "\n",
    "# تست T برای مقایسه رشته‌ها\n",
    "stem = df[df['Discipline'] == 'STEM']['Avg_PSI_Target']\n",
    "soc = df[df['Discipline'] == 'Social Science']['Avg_PSI_Target']\n",
    "t_stat, p_val = stats.ttest_ind(stem, soc, equal_var=False)\n",
    "print(f'\\nWelch\\'s t-test results: t={t_stat:.4f}, p={p_val:.4f}')"
   ]
  }
 ],
 "metadata": { "kernelspec": { "display_name": "Python 3", "language": "python", "name": "python3" }, "nbformat": 4, "nbformat_minor": 4 }
